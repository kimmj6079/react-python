# docker-compose 운영 배포용 환경변수 예시 파일.
# cp .env.prod.example .env.prod 후 실제 강한 값으로 수정할 것 (.env.prod는 gitignore됨).
# DATABASE_URL/BACKEND_CORS_ORIGINS는 docker-compose.prod.yml 안에서 아래 값들을
# 조합해 만들어지므로 여기에 직접 넣지 않는다(중복 방지).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# 반드시 강한 값으로 교체할 것 - 이 값이 그대로면 배포 스크립트가 경고한다.
POSTGRES_DB=app

# VM 공인 IP. DOMAIN을 비워두면 nginx-proxy/conf.d/의 서버 블록과
# BACKEND_CORS_ORIGINS가 이 값을 app.<APP_HOST>.nip.io 형태로 조합해서 쓴다.
APP_HOST=123.123.12.0

# 실제 운영 도메인이 생기기 전(지금, 테스트 단계)에는 비워둘 것 - 비어있으면
# 위 APP_HOST로 app.<APP_HOST>.nip.io를 자동 계산해서 쓴다. 나중에 도메인을
# 구매해 SSL 인증서(nginx-proxy/ssl/README.md 참고)까지 설치하면 여기에
# 실제 도메인(예: myapp.com)을 채워라 - nginx-proxy/conf.d/app.conf의
# server_name과 BACKEND_CORS_ORIGINS가 자동으로 이 값을 쓰게 된다.
DOMAIN=

# 배포에 쓸 이미지 태그. 기본값 latest는 cd.yml이 main 푸시마다 새로 덮어쓰는
# 이동 태그라 롤백에 못 쓴다. 배포 후 문제가 생기면: GitHub → Packages →
# react-python-backend(또는 frontend)에서 직전 정상 커밋의 sha-xxxxxxx 태그를
# 확인해 여기에 채우고 deploy-prod-compose.sh를 재실행하면 그 시점 이미지로
# 즉시 롤백된다. 주의: 이건 애플리케이션 코드만 되돌릴 뿐, DB 마이그레이션은
# 자동으로 되돌아가지 않는다 - 롤백 대상 버전 이후에 스키마 변경이 있었다면
# 별도로 alembic downgrade가 필요할 수 있다.
IMAGE_TAG=latest

# GHCR 패키지(react-python-backend/frontend)를 Public으로 전환하지 않고 Private로
# 유지할 경우에만 채운다. deploy-prod-compose.sh가 pull 전에 이 값으로 VM에서
# `docker login ghcr.io`를 자동 실행한다. 패키지를 Public으로 전환했다면 이 두 줄은
# 비워두면 된다(스크립트가 로그인 단계를 건너뜀).
#
# GHCR_TOKEN 발급 방법 (반드시 "Tokens (classic)" - Fine-grained 아님, GHCR 로그인은
# classic PAT의 read:packages scope 기준으로 지원됨):
#   1. GitHub 우측 상단 프로필 → Settings → Developer settings
#      → Personal access tokens → Tokens (classic)
#   2. "Generate new token" → "Generate new token (classic)"
#   3. Note에 용도 기입 (예: react-python-ghcr-pull), Expiration은 무기한 대신
#      기간을 정해서 설정 (만료되면 재발급 후 이 값을 갱신해야 함)
#   4. "Select scopes"에서 read:packages 딱 하나만 체크
#      (write:packages/delete:packages, repo 등 다른 scope는 불필요 - 최소 권한 원칙)
#   5. "Generate token" 클릭 → 화면에 표시되는 ghp_로 시작하는 값은 이때 한 번만
#      보이므로(재조회 불가) 바로 복사해서 아래 GHCR_TOKEN에 붙여넣을 것
#   6. GHCR_USERNAME에는 GitHub 로그인 계정명(표시 이름/이메일이 아님)을 넣는다
#
# 채우고 나서 VM에 배포하기 전에 로컬에서 토큰이 유효한지 미리 확인하려면:
#   echo "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USERNAME" --password-stdin
GHCR_USERNAME=
GHCR_TOKEN=

# ─────────────────────────────────────────────────────────────
# 챗봇 (M5에서 추가)
# ─────────────────────────────────────────────────────────────
# ★ ANTHROPIC_API_KEY가 비면 배포는 "성공"한다 ★ 앱이 정상적으로 뜨고 헬스체크도
# 통과하고 items CRUD도 전부 돈다. /api/v1/chat만 401을 준다. 배포 직후 헬스체크만
# 보고 넘어가면 못 잡으므로, 배포 확인 절차에 **채팅 한 번 쳐보기**를 넣는다.
# console.anthropic.com에서 발급한다.
ANTHROPIC_API_KEY=

# 벡터 저장소: qdrant | pgvector
# 기본값 qdrant는 docker-compose.prod.yml의 qdrant 서비스를 쓴다. VM 메모리가
# 빠듯하면 pgvector로 내려 서비스 하나를 줄일 수 있다 - 이미 떠 있는 Postgres를
# 재사용하므로 인프라가 안 늘어난다.
# ★ 공짜가 아니다 ★ M8의 하이브리드 검색(dense+BM25)을 잃는다. 실측으로
# 전체 MRR 0.860 -> 0.816, keyword MRR 1.000 -> 0.893.
# 그리고 **저장소를 바꾸면 그쪽에 문서를 따로 인입해야 한다** - 한쪽에만 넣은 채
# 전환하면 챗봇이 "문서를 못 찾는다"고 답한다(에러가 아니다).
VECTOR_STORE=qdrant
QDRANT_COLLECTION=document_chunks

# --- 관측성 (Langfuse) ---
# 비워도 된다. 비면 트레이싱이 no-op이고 앱은 그대로 돈다.
# ★ 다만 비우면 👍/👎 피드백 버튼이 화면에서 사라진다 ★ traceId가 응답에 안 실리면
# 프론트가 버튼을 그리지 않기 때문이다(M13-a의 "저장할 곳이 없으면 버튼도 없다").
# cloud.langfuse.com → 프로젝트 → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# self-host로 옮기려면 이 한 줄만 바꾼다. 프롬프트/응답 본문이 그대로 나가므로
# 개인정보가 섞이는 서비스라면 self-host나 mask 옵션이 사실상 필수다.
LANGFUSE_HOST=https://cloud.langfuse.com

# 대화 영속화: postgres | memory  (M5-2)
# postgres면 컨테이너를 다시 만들어도 진행 중이던 대화가 이어진다. 이미 떠 있는
# Postgres를 재사용하므로 인프라가 늘지 않는다 - 테이블만 한 번 만들면 된다
# (배포 절차의 `python -m app.db.checkpointer_setup`).
CHECKPOINTER=postgres
