# --- Python / backend ---
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
# M13-c 임베딩 캐시 (sqlite). 지워도 다시 계산될 뿐이다.
.cache/
# M13-d 👎 편입 초안. ★ 커밋하지 않는다 ★ 실제 사용자가 친 질문이 그대로 들어 있어
# 개인정보가 섞일 수 있고, 무엇보다 이건 "처리할 일 목록"이지 기록이 아니다.
# 기록으로 남는 것은 사람이 검토해 골든셋(evals/dataset.jsonl)에 옮긴 줄뿐이다.
backend/evals/inbox/

# 브라우저 자동화(Playwright MCP)가 검증 중 남기는 스냅샷/콘솔 로그. 산출물이 아니다.
.playwright-mcp/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/

# --- Env files (never commit real secrets) ---
.env
backend/.env
frontend/.env
k8s/base/secret.yaml
.env.prod
nginx-proxy/ssl/*.pem
nginx-proxy/ssl/*.key
nginx-proxy/ssl/*.crt

# --- 암호화된 시크릿 (backend/.env.enc) ---
# backend/.env.enc 와 backend/.env.pubkey.asc 는 ★ 커밋해야 하는 ★ 파일이라 여기 없다.
#   .env.enc      = 암호문. 개인키 없이는 못 연다
#   .env.pubkey.asc = 공개키. 공개돼도 되는 것이 공개키의 정의다(암호화만 가능, 복호화 불가)
# 절대 들어오면 안 되는 것은 "개인키를 내보낸 파일" 하나뿐이다.
# 백업하려고 export한 뒤 리포 안에 두고 잊어버리는 사고를 막는다 — SETUP.md 참고.
*secret*.asc
*private*.asc
*.gpg-key

# --- Editors / OS ---
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# --- Docker ---
*.log
