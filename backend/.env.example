# Copy to backend/.env for local (non-docker-compose) development.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app
BACKEND_CORS_ORIGINS=http://localhost:5173
# console.anthropic.com에서 발급받아 backend/.env에 실제 값으로 채운다.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# --- RAG 저장소 (M3-4) ---
# 어느 벡터 저장소를 쓸 것인가: pgvector | qdrant
# 이 값 하나로 인입(app.rag.ingest)·검색(app.rag.retriever)·챗봇이 통째로 갈아끼워진다.
# CLI는 --store 플래그로 이 값을 무시하고 지정할 수도 있다.
#
# ★ M8에서 기본값이 pgvector → qdrant로 바뀌었는데 이 템플릿만 안 따라왔었다 (M5에서 정정) ★
# 측정이 정했다: pgvector(dense-only) MRR 0.816 vs qdrant(hybrid) MRR 0.860,
# keyword MRR은 0.893 → 1.000. M8~M13의 모든 기준선이 qdrant에서 나온 숫자다.
# 템플릿이 코드 기본값과 어긋나 있으면 새로 클론한 사람이 **측정한 적 없는 구성으로**
# 개발하게 된다 — 그리고 그 사실을 아무도 모른다.
VECTOR_STORE=qdrant
# Qdrant 접속 주소. docker-compose로 띄우면 localhost:6333,
# 컨테이너 "안"에서는 docker-compose.yml이 http://qdrant:6333으로 덮어쓴다.
QDRANT_URL=http://localhost:6333
# 컬렉션 이름 = pgvector의 테이블 이름에 해당. M7에서 docs_v1/docs_v2 A/B 비교에 쓴다.
QDRANT_COLLECTION=document_chunks

# --- 대화 영속화 (M5-2) ---
# postgres | memory. postgres면 --reload가 재시작해도 대화가 살아남는다.
# ★ 최초 1회 테이블을 만들어야 한다 ★  uv run python -m app.db.checkpointer_setup
#
# ★ Windows 함정 ★ psycopg 비동기는 Windows 기본 이벤트 루프에서 동작하지 않는다.
# uvicorn은 --reload일 때만 Selector 루프를 쓰므로, `uvicorn app.main:app --reload`로
# 띄우면 정상이고 --reload를 빼면 기동 시점에 명시적 에러로 죽는다.
# 그때는 CHECKPOINTER=memory로 두거나 docker compose로 띄운다.
CHECKPOINTER=postgres

# --- 관측성 / 트레이싱 (Langfuse, M4) ---
# 비워두면 트레이싱이 꺼진다(no-op). 앱은 그대로 동작하고 트레이스만 안 쌓인다 —
# 키가 없는 CI·새로 클론한 로컬에서도 문제없이 뜨게 하려는 의도적 설계다.
# cloud.langfuse.com 가입 → 프로젝트 → Settings → API Keys 에서 발급받는다.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# self-host로 옮기려면 이 한 줄만 바꾼다 (예: http://localhost:3000).
LANGFUSE_HOST=https://cloud.langfuse.com

# ─────────────────────────────────────────────────────────────
# ★ 실제 키가 필요하면 이 템플릿 대신 암호화된 값을 복호화한다 ★
#     gpg --import react-python-env-secret.asc   # 개인키 (비밀번호 관리자에 보관)
#     ./scripts/env-decrypt.sh                   # backend/.env 생성
# 값을 바꿨으면 ./scripts/env-encrypt.sh 로 다시 암호화해 .env.enc를 커밋한다.
# 자세한 설명: SETUP.md의 "B-4-1) 시크릿 복원" 절
# ─────────────────────────────────────────────────────────────
