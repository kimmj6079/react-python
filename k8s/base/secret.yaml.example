# Copy to k8s/base/secret.yaml (gitignored) and replace with real values
# before applying. Never commit the real secret.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: study-app
type: Opaque
stringData:
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: postgres
  DATABASE_URL: postgresql+psycopg://postgres:postgres@postgres:5432/app
