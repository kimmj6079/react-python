# Copy to k8s/base/secret.yaml (gitignored) and replace with real values
# before applying. Never commit the real secret.yaml.
# (한글) 이 파일을 그대로 적용하지 말고 k8s/base/secret.yaml로 복사한 뒤
# 실제 값으로 바꿔서 써라. secret.yaml은 .gitignore에 등록돼 있어 저장소에
# 올라가지 않는다 -- 그래서 새로 클론했을 땐 이 example 파일만 존재한다.
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
  namespace: study-app
type: Opaque   # 특별한 형식(TLS 인증서 등) 없이 임의의 key-value를 담는 기본 Secret 타입
stringData:   # base64로 직접 인코딩할 필요 없이 평문으로 적으면 k8s가 알아서 인코딩해준다
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: postgres   # 스터디용 더미 값. 실서버(클라우드 VM 등)에 쓸 땐 반드시 강한 값으로 교체
  DATABASE_URL: postgresql+psycopg://postgres:postgres@postgres:5432/app   # `postgres`는 postgres-service.yaml의 Service 이름(DNS)

  # --- 챗봇 (M5에서 추가) ---
  # ★ 이 키가 없으면 챗봇만 죽고 나머지는 멀쩡하다 ★ config.py의 기본값이 빈 문자열이라
  # 앱은 정상적으로 뜨고 items CRUD도 다 돈다. 그런데 /api/v1/chat을 부르는 순간
  # Anthropic이 401을 준다. "배포는 성공했는데 한 기능만 안 되는" 모양이라,
  # 배포 직후 헬스체크만 보고 넘어가면 못 잡는다 — 반드시 채팅을 한 번 쳐봐야 한다.
  # console.anthropic.com에서 발급한다.
  ANTHROPIC_API_KEY: sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

  # --- 관측성 (Langfuse, M4 / M13-a) ---
  # ★ 비워도 된다 ★ 비면 트레이싱이 no-op이 되고 앱은 그대로 돈다(core/tracing.py의
  # get_callbacks가 빈 리스트를 준다). 다만 비우면 **👍/👎 피드백 버튼이 화면에서
  # 사라진다** — traceId가 안 실리면 프론트가 버튼을 안 그리기 때문이다(M13-a).
  # "저장할 곳이 없으면 버튼도 없다"가 설계상 자동으로 성립하는 지점이고,
  # 그래서 여기를 비우는 것은 "트레이싱만 끄기"가 아니라 "피드백 루프도 끄기"다.
  # cloud.langfuse.com → 프로젝트 → Settings → API Keys 에서 발급한다.
  # 비워둘 거면 두 줄을 통째로 지운다(빈 문자열로 두어도 langfuse_enabled가 False다).
  LANGFUSE_PUBLIC_KEY: pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
  LANGFUSE_SECRET_KEY: sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
